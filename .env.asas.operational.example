# Copy to .env.asas.operational.local and replace every placeholder.
POSTGRES_DB=asas_operational
POSTGRES_USER=asas_operational
POSTGRES_PASSWORD=replace-with-a-long-random-secret
ASAS_OPERATIONAL_DATABASE_URL=postgresql+psycopg://asas_operational:replace-with-a-long-random-secret@operational-database:5432/asas_operational
