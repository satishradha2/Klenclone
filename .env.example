# Production/staging PostgreSQL example:
# KLEN_DATABASE_URL=postgresql+psycopg://klen_user:change-me@localhost:5432/klen_staging

# If unset, the CLI uses sqlite:///var/klen_staging.db for local verification.
KLEN_SNAPSHOT=bizmodo-2026-09-08-browser
KLEN_PORT=8080
KLEN_PRODUCTION_MODE=false
KLEN_AUTH_ENABLED=false
KLEN_UAT_AUTH_ENABLED=false
KLEN_TOKEN_TTL_SECONDS=1800

# Required only when authentication is deliberately enabled. Use a secrets
# manager in deployed environments and provide at least 32 unpredictable chars.
# KLEN_AUTH_SECRET=replace-through-a-secrets-manager
# KLEN_COOKIE_SECURE=true
# KLEN_UAT_REVIEW_DATABASE=var/klen_uat_reviews.db

# Used only by the isolated PostgreSQL compose profile. Keep this URL-safe
# because it is also inserted into the SQLAlchemy connection URL.
KLEN_POSTGRES_PASSWORD=replace-with-a-long-url-safe-secret
