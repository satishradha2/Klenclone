# Copy to .env.asas.local for local ERP preview use.
ASAS_AUTH_ENABLED=true
ASAS_POSTING_ENABLED=false
ASAS_ERP_PREVIEW_PORT=18082
ASAS_SESSION_TTL_SECONDS=1800
ASAS_USERS_FILE=/run/asas-secrets/users.json
ASAS_PRODUCTION_MODE=false
ASAS_SECURE_COOKIES=false
ASAS_ALLOWED_HOSTS=127.0.0.1,localhost

# Production only: generate at least 32 random characters and supply it from a secret manager.
ASAS_SESSION_SECRET=

# Posting requires all three settings. Keep disabled until approved cutover.
ASAS_POSTING_ACTIVATION_CONFIRMED=false
ASAS_POSTING_APPROVAL_REFERENCE=

# Keep credentials in the ignored .secrets/asas-users.json file.
# Never commit real provisioned-user password hashes.
