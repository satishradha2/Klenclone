# Production values must be injected by the deployment platform or secret manager.
ASAS_AUTH_ENABLED=true
ASAS_PRODUCTION_MODE=true
ASAS_POSTING_ENABLED=false
ASAS_POSTING_ACTIVATION_CONFIRMED=false
ASAS_POSTING_APPROVAL_REFERENCE=
ASAS_SESSION_TTL_SECONDS=1800
ASAS_SESSION_SECRET=replace-with-at-least-32-random-characters
ASAS_SECURE_COOKIES=true
ASAS_ALLOWED_HOSTS=erp.example.com
ASAS_TRUSTED_PROXY_IPS=10.0.0.10
ASAS_USERS_FILE=/run/secrets/asas_users
ASAS_OPERATIONAL_DATABASE_URL=postgresql+psycopg://user:password@operational-database:5432/asas_operational
